# ===== 环境变量配置模板 =====
# 使用方法：复制本文件为 .env 并按实际环境修改；.env 已被 .gitignore 忽略，请勿提交

# 服务端口
PORT=5000

# MongoDB 连接串（本地开发示例）
MONGO_URI=mongodb://127.0.0.1:27017/llm_finetune_home

# GitHub API Token（可选）：配置后可提升 API 调用限流额度
GITHUB_TOKEN=

# JWT 签名密钥：登录鉴权使用，请修改为随机字符串
JWT_SECRET=change_me

# 运行环境
NODE_ENV=development

# 跨域白名单：生产环境必填，多个域名用英文逗号分隔（开发环境已自动放行 localhost:5173）
CORS_ORIGINS=http://localhost:5173
